# Leave these empty to play in local mode (saves stay in this browser, no password needed).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The lore scribe (optional): the Cloudflare Worker from moody-bitch/worker. Needs a signed-in cloud player.
# Add this app's origin to the worker's ALLOWED_ORIGINS.
VITE_LORE_PROXY_URL=https://woodrock.skyrim-lore.workers.dev

# Where the site is served from. GitHub Pages project sites use /<repo>/.
# VITE_BASE_PATH=/skyrim-quests/
